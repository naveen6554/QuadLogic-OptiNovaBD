# ===================================================================
# OptiNova Backend - Production Environment Variables Template
# ===================================================================

# Aiven Cloud MySQL 8.4.8 Connection Settings
DB_HOST=optinova-mysql-optinova.l.aivencloud.com
DB_PORT=27675
DB_NAME=defaultdb
DB_USER=avnadmin
DB_USERNAME=avnadmin
DB_PASSWORD=
DB_SSL=true
DB_SSL_MODE=REQUIRED

# Production JWT Configuration
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Gmail SMTP Production Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Razorpay Payment Gateway Production Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Active Spring Profile
SPRING_PROFILES_ACTIVE=prod
